# Copy to .env.local for `npm run dev` (never commit .env.local).
# Used by the gateway (api/gateway.ts), which runs on the server; the browser never sees them.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# select value from public.app_secrets where key = 'gateway_secret';
DPV_GATEWAY_SECRET=
